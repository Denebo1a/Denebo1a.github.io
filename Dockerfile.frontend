FROM node:24-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG VITEPRESS_SITE_HOSTNAME
ARG VITEPRESS_ASSET_BASE
ARG VITEPRESS_ARTALK_SERVER
ARG VITEPRESS_BUSUANZI_SCRIPT_URL

ENV VITEPRESS_SITE_HOSTNAME=${VITEPRESS_SITE_HOSTNAME}
ENV VITEPRESS_ASSET_BASE=${VITEPRESS_ASSET_BASE}
ENV VITEPRESS_ARTALK_SERVER=${VITEPRESS_ARTALK_SERVER}
ENV VITEPRESS_BUSUANZI_SCRIPT_URL=${VITEPRESS_BUSUANZI_SCRIPT_URL}

RUN npm run docs:build

FROM nginx:alpine
COPY server/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/docs/.vitepress/dist /usr/share/nginx/html
